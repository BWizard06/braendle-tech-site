---
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import CornerNav from '../components/CornerNav.astro';
import { CONTACT, hero } from '../content';
import { LOCALES, otherLocale, pick, type Locale, type Localized } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  skip: string;
  home: Localized;
  toLight: Localized;
  toDark: Localized;
  languageName: Localized;
}

const { locale, title, description, skip, home, toLight, toDark, languageName } = Astro.props;
const localizedPath = (l: Locale): string => `/${l}/`;

const OG_LOCALES: Record<Locale, string> = { de: 'de_CH', en: 'en_GB' };

const canonical = new URL(localizedPath(locale), Astro.site);
const ogImage = new URL(`/og-${locale}.png`, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: hero.name,
  url: canonical.href,
  image: ogImage.href,
  jobTitle: locale === 'de' ? 'Fullstack Developer' : 'Fullstack developer',
  email: `mailto:${CONTACT.email}`,
  sameAs: [CONTACT.linkedin],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Herrliberg',
    addressRegion: 'Zürich',
    addressCountry: 'CH',
  },
  knowsLanguage: ['de', 'en'],
};
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={hero.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pick(hero.alt, locale)} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    <meta property="og:locale:alternate" content={OG_LOCALES[otherLocale(locale)]} />
    <meta property="profile:first_name" content="Ben" />
    <meta property="profile:last_name" content="Brändle" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pick(hero.alt, locale)} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localizedPath(l), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('de'), Astro.site)} />
    <ClientRouter />
    <script is:inline>
      (function () {
        function apply() {
          try {
            var stored = localStorage.getItem('braendle-theme');
            if (stored === 'light' || stored === 'dark') {
              document.documentElement.dataset.theme = stored;
            } else {
              delete document.documentElement.dataset.theme;
            }
          } catch (error) {}
        }
        apply();
        if (!window.__braendleThemeBound) {
          window.__braendleThemeBound = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    {
      import.meta.env.DEV && (
        <script
          is:inline
          type="module"
          set:html={`import RefreshRuntime from "/@react-refresh";
RefreshRuntime.injectIntoGlobalHook(window);
window.$RefreshReg$ = () => {};
window.$RefreshSig$ = () => (type) => type;
window.__vite_plugin_react_preamble_installed__ = true;`}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#inhalt">{skip}</a>

    <CornerNav
      locale={locale}
      home={home}
      toLight={toLight}
      toDark={toDark}
      languageName={languageName}
    />

    <main id="inhalt">
      <slot />
    </main>

    <script>
      import { restoreAnchor } from '../lib/anchor';

      let revealed: HTMLElement | null = null;

      function reveal(): void {
        const main = document.querySelector<HTMLElement>('main');
        if (!main || main === revealed) return;
        revealed = main;

        const nodes = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (!nodes.length) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          nodes.forEach((node) => node.setAttribute('data-reveal', 'shown'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.setAttribute('data-reveal', 'shown');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px' },
        );

        nodes.forEach((node) => observer.observe(node));
      }

      document.addEventListener('astro:after-swap', () => restoreAnchor(true));
      document.addEventListener('astro:page-load', reveal);

      if (document.readyState !== 'loading') reveal();
      else document.addEventListener('DOMContentLoaded', reveal, { once: true });
    </script>
  </body>
</html>
