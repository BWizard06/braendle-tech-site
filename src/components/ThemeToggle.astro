---
interface Props {
  toLight: string;
  toDark: string;
}

const { toLight, toDark } = Astro.props;
---

<button
  class="pill pill--icon theme-toggle"
  type="button"
  data-theme-toggle
  data-label-light={toLight}
  data-label-dark={toDark}
  aria-label={toDark}
>
  <svg class="theme-toggle__mark" viewBox="0 0 24 24" role="presentation" focusable="false">
    <circle cx="12" cy="12" r="7.5" fill="none" stroke="currentColor" stroke-width="1.6" />
    <path d="M12 4.5a7.5 7.5 0 0 1 0 15Z" fill="currentColor" />
  </svg>
</button>

<script>
  import { applyTheme, resolveTheme } from '../lib/theme';

  function label(button: HTMLElement, theme: 'light' | 'dark'): void {
    const next = theme === 'dark' ? 'light' : 'dark';
    const text = next === 'dark' ? button.dataset.labelDark : button.dataset.labelLight;
    if (text) button.setAttribute('aria-label', text);
    button.dataset.themeState = theme;
  }

  let bound: HTMLButtonElement | null = null;

  function setup(): void {
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!button || button === bound) return;
    bound = button;

    label(button, resolveTheme());

    button.addEventListener('click', () => {
      const next = resolveTheme() === 'dark' ? 'light' : 'dark';
      applyTheme(next);
      label(button, next);
    });

    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => label(button, resolveTheme()));
  }

  document.addEventListener('astro:page-load', setup);
  if (document.readyState !== 'loading') setup();
  else document.addEventListener('DOMContentLoaded', setup, { once: true });
</script>

<style>
  .theme-toggle__mark {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.45s var(--ease-out);
  }

  .theme-toggle[data-theme-state='dark'] .theme-toggle__mark {
    transform: rotate(180deg);
  }
</style>
