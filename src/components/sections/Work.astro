---
import { pick, type Locale } from '../../lib/i18n';
import { personalProjects, projectCategories, type Reference } from '../../content';

interface Props {
  locale: Locale;
  kicker: string;
  visit: string;
  source: string;
  references: Reference[];
}

const { locale, kicker, visit, source, references } = Astro.props;

const linksOf = (reference: Reference) =>
  [
    { href: reference.url, label: reference.visitLabel ? pick(reference.visitLabel, locale) : visit, kind: 'site' },
    ...(reference.source ? [{ href: reference.source, label: source, kind: 'source' }] : []),
  ] as const;

const groups = [
  { id: 'client-projects', label: projectCategories.client, projects: references },
  { id: 'personal-projects', label: projectCategories.personal, projects: personalProjects },
];
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="u-shell">
    <header class="work__head" data-reveal>
      <h2 class="u-kicker" id="work-title">{kicker}</h2>
    </header>

    {groups.map((group) => (
      <section class="work__group" aria-labelledby={group.id}>
        <h3 class="work__category" id={group.id}>{pick(group.label, locale)}</h3>
        {group.projects.map((reference) => (
        <article class="work__item" id={`project-${reference.id}`} data-reveal>
          <div class="work__meta">
            <a
              class="work__preview"
              href={reference.url}
              target="_blank"
              rel="noreferrer noopener"
              aria-label={`${reference.name} – ${reference.visitLabel ? pick(reference.visitLabel, locale) : visit}`}
            >
              <img
                src={reference.image}
                alt={pick(reference.alt, locale)}
                width={reference.imageWidth}
                height={reference.imageHeight}
                loading="lazy"
                decoding="async"
              />
            </a>
            <h4 class="work__name">{reference.name}</h4>
            <p class="work__role">{pick(reference.role, locale)}</p>
            <div class="work__links">
              {linksOf(reference).map((link) => (
                <a
                  class="pill"
                  href={link.href}
                  rel="noreferrer noopener"
                  target="_blank"
                  data-work-link={link.kind}
                >
                  {link.label}
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="work__arrow">
                    <path
                      d="M4 12L12 4M6 4h6v6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              ))}
            </div>
          </div>

          <div class="work__body">
            <p class="work__lead">{pick(reference.body, locale)}</p>
            {reference.bullets.length > 0 && <ul class="work__bullets">
              {reference.bullets.map((bullet) => (
                <li>{pick(bullet, locale)}</li>
              ))}
            </ul>}
            {reference.tags && <ul class="work__tags">
              {reference.tags.map((tag) => <li>{tag}</li>)}
            </ul>}
            {reference.note && <p class="work__note">{pick(reference.note, locale)}</p>}
          </div>
        </article>
        ))}
      </section>
    ))}
  </div>
</section>

<style>
  .work {
    padding-block: clamp(2.75rem, 5vw, 4rem);
    border-top: 1px solid var(--rule);
  }

  .work__head {
    max-width: 40rem;
    margin-bottom: var(--space-l);
  }

  .work__group + .work__group {
    margin-top: var(--space-2xl);
  }

  .work__category {
    margin-bottom: var(--space-m);
    font-size: var(--step-0);
    font-weight: 500;
  }

  .work__item + .work__item {
    margin-top: var(--space-xl);
  }

  .work__preview {
    display: block;
    overflow: hidden;
    margin-bottom: var(--space-m);
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--bg);
    aspect-ratio: 16 / 9;
  }

  .work__preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .work__note {
    margin-top: var(--space-m);
    max-width: var(--measure);
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .work__item {
    display: grid;
    gap: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .work__name {
    font-size: var(--step-2);
  }

  .work__role {
    margin-top: var(--space-3xs);
    color: var(--fg-muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .work__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-m);
  }

  .work__arrow {
    width: 0.85em;
    height: 0.85em;
  }

  .work__lead {
    max-width: var(--measure);
    font-size: var(--step-1);
    text-wrap: pretty;
  }

  .work__bullets {
    max-width: var(--measure);
    margin-top: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .work__bullets li {
    padding-block: var(--space-2xs);
    padding-left: var(--space-m);
    color: var(--fg-muted);
    text-indent: calc(var(--space-m) * -1);
  }

  .work__bullets li::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 1px;
    margin-right: calc(var(--space-m) - 0.5rem);
    background: var(--accent);
    vertical-align: 0.4em;
  }

  @media (min-width: 52rem) {
    .work__item {
      grid-template-columns: minmax(14rem, 22rem) 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
