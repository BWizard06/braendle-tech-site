---
import type { Locale } from '../../lib/i18n';
interface Props {
  name: string; lineAccent: string; lineAfter: string; intro: string; alt: string; locale: Locale;
}
const { name, lineAccent, lineAfter, intro, locale } = Astro.props;
const de = locale === 'de';
---
<section class="hero" id="start" aria-labelledby="hero-name" data-hero>
  <div class="u-shell hero__shell">
    <div class="hero__inner">
      <div class="hero__text">
        <h1 class="hero__name" id="hero-name" data-name-decode>{name}</h1>
        <p class="hero__line"><em class="accent">{lineAccent}</em>{lineAfter}</p>
        <p class="hero__intro">{intro}</p>
        <div class="hero__actions"><slot name="actions" /></div>
      </div>
      <div class="hero__visual" data-hero-visual>
        <div class="hero__stage">
          <div class="hero__frame" data-ben-anchor>
            <img data-ben-poster class="hero__poster" src="/images/ben-poster.webp" width="800" height="900" alt={de ? 'Ben als 3D-Figur mit braunem Haar, schwarzem Hoodie und weissen Sneakern' : 'A 3D Ben with brown hair, a black hoodie and white trainers'} fetchpriority="high" />
          </div>
          <span class="hero__ground" aria-hidden="true"></span>
        </div>
        <div class="hero__interaction">
          <p class="hero__welcome">{de ? 'Hi, ich bin Ben.' : 'Hi, I’m Ben.'}</p>
          <a class="hero__meet" href={`/${locale}/ben/`} data-astro-reload>{de ? 'Ben in 3D entdecken' : 'Meet Ben in 3D'} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <a class="hero__scroll" href="#stack" aria-label={de ? 'Zu den Technologien scrollen' : 'Scroll to the technologies'}>
      <span class="hero__scroll-label">Scroll</span>
      <svg class="hero__scroll-arrow" width="12" height="30" viewBox="0 0 12 30" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 1v27M1.5 23.5 6 28l4.5-4.5" /></svg>
    </a>
  </div>
</section>
<style>
  .hero { min-height: min(960px,100svh); display: flex; flex-direction: column; padding-block: 7rem 1.25rem; }
  .hero__shell { flex: 1; display: flex; flex-direction: column; }
  .hero__inner { display: grid; grid-template-columns: 1.05fr 1fr; gap: 3rem; align-items: center; margin-block: auto; }
  .hero__name { max-width: 8ch; font-size: clamp(4.2rem, 7.4vw, 7rem); font-weight: 550; letter-spacing: -.055em; line-height: .96; }
  .hero__line { font-size: var(--step-3); line-height: 1.2; margin-top: 1.5rem; letter-spacing: var(--tracking-tight); }
  .hero__intro { max-width: 31rem; margin-top: 1.75rem; color: var(--fg-muted); font-size: 1rem; line-height: 1.7; text-wrap: pretty; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.75rem; }
  .hero__visual { min-width: 0; position: relative; }
  .hero__stage { position: relative; height: 420px; }
  .hero__frame { position: absolute; width: 100%; height: 100%; }
  .hero__poster { width: 100%; height: 100%; object-fit: contain; position: relative; z-index: 1; }
  .hero__ground { position: absolute; bottom: 5%; left: 28%; width: 44%; height: 16px; border-radius: 50%; background: var(--fg); opacity: .10; filter: blur(10px); }
  .hero__interaction { display: grid; justify-items: center; gap: .15rem; margin-top: .75rem; text-align: center; }
  .hero__welcome { font-family: var(--font-accent); font-size: 1.9rem; font-style: italic; line-height: 1.2; }
  .hero__meet { display: inline-flex; align-items: center; gap: .45rem; padding-block: .35rem; font-size: var(--step--1); color: var(--fg-muted); text-decoration: none; transition: color .25s var(--ease-out); }
  .hero__meet span { color: var(--accent); transition: transform .25s var(--ease-out); }
  .hero__meet:hover { color: var(--accent); }
  .hero__meet:hover span { transform: translate(2px,-2px); }
  .hero__scroll { align-self: center; display: flex; flex-direction: column; align-items: center; gap: .65rem; margin-top: 2.5rem; padding: .5rem .75rem; color: var(--fg-muted); text-decoration: none; transition: color .25s var(--ease-out); }
  .hero__scroll:hover { color: var(--fg); }
  /* Letter spacing trails the last letter; the same space in front keeps the word centred over the arrow. */
  .hero__scroll-label { padding-inline-start: var(--tracking-wide); font-size: .6875rem; font-weight: 500; letter-spacing: var(--tracking-wide); line-height: 1; text-transform: uppercase; }
  .hero__scroll-arrow { display: block; color: var(--accent); animation: hero-scroll-bob 2s ease-in-out infinite; }
  @keyframes hero-scroll-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(5px); } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-arrow { animation: none; } }
  @media (max-width: 61.99rem) {
    .hero { padding-top: 6rem; }
    .hero__inner { grid-template-columns: 1fr; gap: 2rem; }
    .hero__text { max-width: 40rem; }
    .hero__name { max-width: none; font-size: clamp(3.4rem, 10vw, 6rem); }
    .hero__line { font-size: clamp(1.45rem, 4vw, 2.4rem); }
    .hero__intro { max-width: 36rem; }
    .hero__stage { height: 330px; max-width: 350px; margin-inline: auto; }
    .hero__scroll { margin-top: 2rem; }
    .hero__interaction { margin-top: .5rem; }
  }
  @media (max-width: 380px) { .hero__line { font-size: 1.35rem; } .hero__stage { height: 290px; } }
  @media (max-width: 48rem) {
    .hero__inner { display: flex; flex-direction: column; align-items: stretch; gap: 0; }
    .hero__text { display: contents; }
    .hero__name { order: 1; }
    .hero__line { order: 2; margin-top: 1rem; }
    .hero__visual { order: 3; margin-top: 1.5rem; }
    .hero__stage { height: 285px; max-width: 310px; }
    .hero__intro { order: 4; margin-top: 1.75rem; }
    .hero__actions { order: 5; }
  }
</style>
